{
    "id": "es.esplay.webos",
    "version": "3.0.0",
    "vendor": "EsPlay",
    "type": "web",
    "main": "index.html",
    "title": "EsPlay",
    "appDescription": "EsPlay para televisores LG",
    "icon": "icon-80.png",
    "largeIcon": "icon-130.png",
    "bgImage": "splash.png",
    "splashBackground": "splash.png",
    "bgColor": "#000000",
    "iconColor": "#141416",
    "disableBackHistoryAPI": true,
    "enablePigScreenSaver": false,
    "requiredPermissions": [
        "time.query",
        "activity.operation",
        "media.operation",
        "audio.operation",
        "settings.read",
        "deviceinfo.read",
        "database"
    ],
    "allowVideoCapture": false,
    "allowAudioCapture": false,
    "handlesRelaunch": true
}
